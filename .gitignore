# Performance logs
perf.data
perf.data.old
*.trace
*.prof

# Memory dumps
*.dump
*.hprof

# ================================
# MISC
# ================================

# Compressed files
*.zip
*.tar.gz
*.rar
*.7z

# Office temporary files
~$*

# Archives
archives/
old/
deprecated/

# Custom project folders
experiments/
scratch/
playground/

# Keep important empty directories
!.gitkeep