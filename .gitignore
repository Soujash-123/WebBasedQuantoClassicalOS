# Virtual File System Storage
vfs_storage/*
!vfs_storage/.gitkeep
virtual_storage/*
!virtual_storage/.gitkeep

# System logs and temporary files
system/logs/*
!system/logs/.gitkeep
system/temp/*
!system/temp/.gitkeep

