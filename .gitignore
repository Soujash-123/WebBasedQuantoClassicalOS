users.json.backup
*.user.json

# Configuration backups
config.json.backup
system_config.json.backup

# Generated files
generated/
output/
exports/

# Test data
test_data/
test_files/

# Debug files
debug/
debug_*.log
debug_output/

# Hot reload files
.hot_reload_*

# API documentation generated files
api_docs/
swagger_docs/

# Backup files
*.bak
*.backup
*.orig

