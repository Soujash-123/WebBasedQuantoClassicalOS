# Environment files with sensitive data
.env.production
.env.staging
.env.secret
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# API keys and secrets
secrets.json
api_keys.txt
credentials.json

# SSL certificates
ssl/
certificates/

# ================================
# DOCUMENTATION & TEMPORARY
# ================================

# Generated documentation
docs/build/
docs/_build/
site/

# Temporary markdown files
*.md.tmp
*.md.backup

# PDF outputs (in case of document generation)
*.pdf

# ================================
# DEPLOYMENT & CI/CD
# ================================

# Docker
.dockerignore
docker-compose.override.yml

# Kubernetes
k8s-local/
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.backup
.terraform/

# GitHub Actions (keep workflow files but ignore local testing)
.github/workflows/local/

# ================================
# PERFORMANCE & MONITORING
